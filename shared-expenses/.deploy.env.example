# Copy to .deploy.env (gitignored) and fill in. Read by cloudflare.config.ts and scripts/migrate.mjs.
SHARED_EXPENSES_D1_ID=00000000-0000-0000-0000-000000000000
# Optional custom domain on a zone in your Cloudflare account. Leave empty to use workers.dev.
SHARED_EXPENSES_DOMAIN=
# Optional. Defaults to https://<SHARED_EXPENSES_DOMAIN>. Set it to the workers.dev address when
# you have no custom domain.
BASE_URL=
