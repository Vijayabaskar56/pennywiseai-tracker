// PennyWise shared expenses (docs/shared-expenses.md). Stores Shared groups as readable rows in D1;
// logs no request bodies, amounts or names.
// Local only: `npm run dev` and the tests read this file. Deploys read cloudflare.config.ts
// (README.md); keep the bindings in both files in step.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pennywise-shared-expenses",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Invite links are built from it; the deployed address is set in cloudflare.config.ts.
	"vars": { "BASE_URL": "http://localhost:8790" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pennywise-shared-expenses",
			// Local runs need no real id; the deployed one is set in cloudflare.config.ts.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// Recurring expenses come due once a day, just after midnight UTC.
	"triggers": { "crons": ["5 0 * * *"] },
	// Same namespaces as cloudflare.config.ts.
	"ratelimits": [
		{ "name": "REGISTER_LIMIT", "namespace_id": "840201", "simple": { "limit": 5, "period": 60 } },
		{ "name": "INVITE_LIMIT", "namespace_id": "840202", "simple": { "limit": 10, "period": 60 } },
		{ "name": "API_LIMIT", "namespace_id": "840203", "simple": { "limit": 300, "period": 60 } }
	],
	"observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
